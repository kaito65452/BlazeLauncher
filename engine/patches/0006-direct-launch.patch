+static DIRECT_LAUNCH: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Mark whether the next `Launcher::resumed` should bypass the engine menu and enter the game directly.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_horizon_android_bridge_BlazeNativeBridge_nativeSetDirectLaunch(
+    _env: jni::JNIEnv<'_>,
+    _class: jni::objects::JClass<'_>,
+    enabled: jni::sys::jboolean,
+) {
+    init_logging();
+    let value = enabled != 0;
+    DIRECT_LAUNCH.store(value, std::sync::atomic::Ordering::SeqCst);
+    log::info!("BlazeDirectLaunch: DIRECT_LAUNCH={value}");
+}
+
+/// Consume the direct-launch flag once so subsequent returns to the launcher show the menu normally.
+pub(crate) fn take_direct_launch() -> bool {
+    DIRECT_LAUNCH.swap(false, std::sync::atomic::Ordering::SeqCst)
+}
