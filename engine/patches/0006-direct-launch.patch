+/// Check whether an Android bridge session is currently staged in memory without consuming it.
+#[cfg(target_os = "android")]
+pub fn has_pending_android() -> bool {
+    PENDING_ANDROID
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .is_some()
+}
