+    let (count, warn) = {
+        let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+        guard.counters.raw_touch_ignored += 1;
+        let count = guard.counters.raw_touch_ignored;
+        let warn = raw_touch_warn_due(count);
+        if warn {
+            guard.counters.raw_touch_warnings += 1;
+        }
+        (count, warn)
+    };
+    if warn {
+        log::warn!(
+            "BlazeInput: raw engine touch reached winit while desktop input is enabled (count={count}); \
+             the Kotlin overlay window should consume all touches"
+        );
+    }
 }
 
