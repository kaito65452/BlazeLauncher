diff --git a/crates/horizon-client/src/android/blaze_diagnostics.rs b/crates/horizon-client/src/android/blaze_diagnostics.rs
new file mode 100644
index 0000000000..56a1729704
--- /dev/null
+++ b/crates/horizon-client/src/android/blaze_diagnostics.rs
@@ -0,0 +1,101 @@
+//! Phase 1a JNI extensions for Blaze Launcher session handoff and synthetic input diagnostics.
+use super::{backend, catalog};
+use jni::{
+    JNIEnv,
+    objects::{JClass, JString},
+    sys::{jboolean, jfloat, jint},
+};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static SYNTHETIC_TOUCH_COUNT: AtomicU64 = AtomicU64::new(0);
+
+fn jstring_to_string(env: &mut JNIEnv<'_>, js: &JString<'_>) -> Option<String> {
+    if js.is_null() {
+        return None;
+    }
+    env.get_string(js).ok().map(Into::into)
+}
+
+/// Hand over ZL2's authenticated Microsoft session into Starling without launching Starling OAuth.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_horizon_android_bridge_BlazeNativeBridge_nativeSetSession(
+    mut env: JNIEnv<'_>,
+    _class: JClass<'_>,
+    user_str: JString<'_>,
+    uuid_str: JString<'_>,
+    access_token_str: JString<'_>,
+) -> jboolean {
+    crate::init_logging();
+    let Some(user) = jstring_to_string(&mut env, &user_str) else {
+        log::warn!("BlazeSessionHandoff: missing player profile string");
+        return 0;
+    };
+    let trimmed_user = user.trim();
+    if trimmed_user.is_empty() || trimmed_user.chars().count() > 16 {
+        log::warn!("BlazeSessionHandoff: invalid player profile length ({})", trimmed_user.chars().count());
+        return 0;
+    }
+    let Some(uuid_raw) = jstring_to_string(&mut env, &uuid_str) else {
+        log::warn!("BlazeSessionHandoff: missing UUID string");
+        return 0;
+    };
+    let Some(parsed_uuid) = horizon_client::auth::parse_uuid(uuid_raw.trim()) else {
+        log::warn!("BlazeSessionHandoff: invalid UUID format");
+        return 0;
+    };
+    let Some(token) = jstring_to_string(&mut env, &access_token_str) else {
+        log::warn!("BlazeSessionHandoff: missing token string");
+        return 0;
+    };
+    if token.is_empty() {
+        log::warn!("BlazeSessionHandoff: empty token rejected");
+        return 0;
+    }
+
+    horizon_client::auth::stage_pending_android(trimmed_user, parsed_uuid, &token);
+    horizon_client::auth::set_current(horizon_client::auth::AuthSession::new(
+        trimmed_user,
+        parsed_uuid,
+        &token,
+    ));
+    if let Some(home) = backend::try_data_dir() {
+        let mut config = catalog::Config::load(&home);
+        config.name = trimmed_user.to_string();
+        if let Err(err) = config.save(&home) {
+            log::warn!("BlazeSessionHandoff: could not save profile name to config: {err}");
+        }
+    }
+    log::info!(
+        "BlazeSessionHandoff: staged AuthSession on :rust (uuid={:032x}, token_len={})",
+        parsed_uuid,
+        token.len()
+    );
+    1
+}
+
+/// Minimal synthetic touch probe reaching Starling's Android input tracker over JNI.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_horizon_android_bridge_BlazeNativeBridge_nativeInjectSyntheticTouch(
+    _env: JNIEnv<'_>,
+    _class: JClass<'_>,
+    x: jfloat,
+    y: jfloat,
+    phase: jint,
+) -> jboolean {
+    crate::init_logging();
+    let phase_name = match phase {
+        0 => "Started",
+        1 => "Moved",
+        2 => "Ended",
+        3 => "Cancelled",
+        _ => "Other",
+    };
+    let seq = SYNTHETIC_TOUCH_COUNT.fetch_add(1, Ordering::Relaxed) + 1;
+    let noted = horizon_client::android_runtime::note_input(
+        horizon_client::android_gamepad::InputMode::Touch,
+    );
+    log::info!(
+        "BlazeInput: synthetic touch arrived via BlazeNativeBridge seq={seq} phase={phase_name} ({phase}) pos=({x:.1}, {y:.1}) note_input={noted}"
+    );
+    1
+}
