+#[cfg(target_os = "android")]
+static PENDING_ANDROID: Mutex<Option<(String, u128, String)>> = Mutex::new(None);
+
+/// Stage an authenticated session handed over from the Kotlin launcher (`BlazeNativeBridge.setSession`).
+#[cfg(target_os = "android")]
+pub fn stage_pending_android(name: &str, uuid: u128, access_token: &str) {
+    *PENDING_ANDROID.lock().unwrap_or_else(|e| e.into_inner()) =
+        Some((name.to_owned(), uuid, access_token.to_owned()));
+}
+
+/// Consume and construct any staged Android bridge session without touching persistent disk state.
+#[cfg(target_os = "android")]
+pub fn take_pending_android() -> Option<AuthSession> {
+    let (name, uuid, access_token) = PENDING_ANDROID
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .take()?;
+    Some(AuthSession::new(&name, uuid, &access_token))
+}
