+static BLAZE_DESKTOP_INPUT: AtomicBool = AtomicBool::new(cfg!(feature = "blaze-embedded"));
+
+pub fn set_blaze_desktop_input(enabled: bool) {
+    BLAZE_DESKTOP_INPUT.store(enabled, Ordering::Release);
+}
+
+pub fn blaze_desktop_input_enabled() -> bool {
+    BLAZE_DESKTOP_INPUT.load(Ordering::Acquire)
+}
+
+pub const BLAZE_INPUT_QUEUE_CAP: usize = 512;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum BlazeInputEvent {
+    Noop,
+    Key {
+        glfw_key: i32,
+        unicode_char: u32,
+        mods: i32,
+        pressed: bool,
+    },
+    MouseButton {
+        glfw_button: i32,
+        mods: i32,
+        pressed: bool,
+    },
+    CursorPos {
+        norm_x: f32,
+        norm_y: f32,
+    },
+    Scroll {
+        dx: f32,
+        dy: f32,
+    },
+    Char {
+        codepoint: u32,
+    },
+    AndroidBack,
+    ResetState,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, serde::Serialize)]
+pub struct BlazeInputCounters {
+    pub key_events: u64,
+    pub mouse_button_events: u64,
+    pub cursor_pos_events: u64,
+    pub mouse_delta_events: u64,
+    pub mouse_delta_coalesced: u64,
+    pub scroll_events: u64,
+    pub char_events: u64,
+    pub android_back_events: u64,
+    pub dropped_overflow: u64,
+    pub drained_events: u64,
+    pub raw_touch_ignored: u64,
+}
+
+struct BlazeInputQueue {
+    ring: [BlazeInputEvent; BLAZE_INPUT_QUEUE_CAP],
+    head: usize,
+    len: usize,
+    pending_delta_x: f64,
+    pending_delta_y: f64,
+    delta_pending_batches: u64,
+    counters: BlazeInputCounters,
+}
+
+impl BlazeInputQueue {
+    const fn new() -> Self {
+        Self {
+            ring: [BlazeInputEvent::Noop; BLAZE_INPUT_QUEUE_CAP],
+            head: 0,
+            len: 0,
+            pending_delta_x: 0.0,
+            pending_delta_y: 0.0,
+            delta_pending_batches: 0,
+            counters: BlazeInputCounters {
+                key_events: 0,
+                mouse_button_events: 0,
+                cursor_pos_events: 0,
+                mouse_delta_events: 0,
+                mouse_delta_coalesced: 0,
+                scroll_events: 0,
+                char_events: 0,
+                android_back_events: 0,
+                dropped_overflow: 0,
+                drained_events: 0,
+                raw_touch_ignored: 0,
+            },
+        }
+    }
+
+    fn push(&mut self, event: BlazeInputEvent) {
+        match event {
+            BlazeInputEvent::Noop => return,
+            BlazeInputEvent::Key { .. } => self.counters.key_events += 1,
+            BlazeInputEvent::MouseButton { .. } => self.counters.mouse_button_events += 1,
+            BlazeInputEvent::CursorPos { .. } => {
+                self.counters.cursor_pos_events += 1;
+                // Coalesce consecutive CursorPos events at the ring tail.
+                if self.len > 0 {
+                    let tail = (self.head + self.len - 1) % BLAZE_INPUT_QUEUE_CAP;
+                    if matches!(self.ring[tail], BlazeInputEvent::CursorPos { .. }) {
+                        self.ring[tail] = event;
+                        return;
+                    }
+                }
+            }
+            BlazeInputEvent::Scroll { .. } => self.counters.scroll_events += 1,
+            BlazeInputEvent::Char { .. } => self.counters.char_events += 1,
+            BlazeInputEvent::AndroidBack => self.counters.android_back_events += 1,
+            BlazeInputEvent::ResetState => {}
+        }
+        if self.len == BLAZE_INPUT_QUEUE_CAP {
+            self.counters.dropped_overflow += 1;
+            self.head = (self.head + 1) % BLAZE_INPUT_QUEUE_CAP;
+            self.len -= 1;
+        }
+        let slot = (self.head + self.len) % BLAZE_INPUT_QUEUE_CAP;
+        self.ring[slot] = event;
+        self.len += 1;
+    }
+
+    fn drain_chunk(&mut self, out: &mut [BlazeInputEvent]) -> usize {
+        let count = self.len.min(out.len());
+        for slot in out.iter_mut().take(count) {
+            *slot = self.ring[self.head];
+            self.ring[self.head] = BlazeInputEvent::Noop;
+            self.head = (self.head + 1) % BLAZE_INPUT_QUEUE_CAP;
+        }
+        self.len -= count;
+        if self.len == 0 {
+            self.head = 0;
+        }
+        self.counters.drained_events += count as u64;
+        count
+    }
+
+    fn push_delta(&mut self, dx: f64, dy: f64) {
+        if !dx.is_finite() || !dy.is_finite() {
+            return;
+        }
+        self.counters.mouse_delta_events += 1;
+        if self.delta_pending_batches > 0 {
+            self.counters.mouse_delta_coalesced += 1;
+        }
+        self.pending_delta_x += dx;
+        self.pending_delta_y += dy;
+        self.delta_pending_batches += 1;
+    }
+
+    fn drain_delta(&mut self) -> (f64, f64) {
+        let out = (self.pending_delta_x, self.pending_delta_y);
+        self.pending_delta_x = 0.0;
+        self.pending_delta_y = 0.0;
+        self.delta_pending_batches = 0;
+        out
+    }
+
+    fn clear_events(&mut self) {
+        for slot in &mut self.ring {
+            *slot = BlazeInputEvent::Noop;
+        }
+        self.head = 0;
+        self.len = 0;
+        self.pending_delta_x = 0.0;
+        self.pending_delta_y = 0.0;
+        self.delta_pending_batches = 0;
+    }
+}
+
+static BLAZE_INPUT_QUEUE: std::sync::Mutex<BlazeInputQueue> =
+    std::sync::Mutex::new(BlazeInputQueue::new());
+
+pub fn push_input_event(event: BlazeInputEvent) {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    guard.push(event);
+}
+
+pub fn push_mouse_delta(dx: f64, dy: f64) {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    guard.push_delta(dx, dy);
+}
+
+pub fn drain_input_chunk(out: &mut [BlazeInputEvent]) -> usize {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    guard.drain_chunk(out)
+}
+
+pub fn drain_mouse_delta() -> (f64, f64) {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    guard.drain_delta()
+}
+
+pub fn clear_input_queue() {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    guard.clear_events();
+}
+
+pub fn reset_input_metrics_for_test() {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    *guard = BlazeInputQueue::new();
+}
+
+pub fn record_raw_touch_ignored() {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    guard.counters.raw_touch_ignored += 1;
+}
+
+pub fn input_counters() -> BlazeInputCounters {
+    let guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    guard.counters
+}
+
+pub fn input_diagnostics_json() -> String {
+    let counters = input_counters();
+    serde_json::json!({
+        "desktop_input_enabled": blaze_desktop_input_enabled(),
+        "counters": counters,
+    })
+    .to_string()
+}
