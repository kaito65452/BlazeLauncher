+pub fn glfw_mods_to_winit(mods: i32) -> winit::keyboard::ModifiersState {
+    use winit::keyboard::ModifiersState;
+    let mut state = ModifiersState::empty();
+    if mods & 0x0001 != 0 {
+        state |= ModifiersState::SHIFT;
+    }
+    if mods & 0x0002 != 0 {
+        state |= ModifiersState::CONTROL;
+    }
+    if mods & 0x0004 != 0 {
+        state |= ModifiersState::ALT;
+    }
+    if mods & 0x0008 != 0 {
+        state |= ModifiersState::SUPER;
+    }
+    state
+}
+
+pub fn glfw_button_to_winit(button: i32) -> Option<winit::event::MouseButton> {
+    use winit::event::MouseButton;
+    Some(match button {
+        0 => MouseButton::Left,
+        1 => MouseButton::Right,
+        2 => MouseButton::Middle,
+        3 => MouseButton::Back,
+        4 => MouseButton::Forward,
+        _ => return None,
+    })
+}
