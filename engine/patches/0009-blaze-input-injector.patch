+/// Inject a desktop keyboard event (GLFW keycode + modifiers + optional Unicode char) into the main loop.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_dev_horizon_android_bridge_BlazeNativeBridge_nativeInjectKey(
+    _env: JNIEnv<'_>,
+    _class: JClass<'_>,
+    key_code: jint,
+    unicode_char: jint,
+    mods: jint,
+    pressed: jboolean,
+) {
+    horizon_client::android_runtime::push_input_event(
+        horizon_client::android_runtime::BlazeInputEvent::Key {
+            glfw_key: key_code,
+            unicode_char: unicode_char.max(0) as u32,
+            mods,
+            pressed: pressed != 0,
+        },
+    );
+}
+
