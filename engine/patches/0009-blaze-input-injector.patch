+#[cfg(test)]
+mod input_bridge_tests {
+    use super::*;
+    use winit::event::MouseButton;
+    use winit::keyboard::{KeyCode, ModifiersState, NamedKey};
+
+    #[test]
+    fn maps_core_glfw_keys_buttons_and_modifiers() {
+        assert_eq!(glfw_keycode_to_winit(87), Some(KeyCode::KeyW));
+        assert_eq!(glfw_keycode_to_winit(65), Some(KeyCode::KeyA));
+        assert_eq!(glfw_keycode_to_winit(83), Some(KeyCode::KeyS));
+        assert_eq!(glfw_keycode_to_winit(68), Some(KeyCode::KeyD));
+        assert_eq!(glfw_keycode_to_winit(32), Some(KeyCode::Space));
+        assert_eq!(glfw_keycode_to_winit(256), Some(KeyCode::Escape));
+        assert_eq!(glfw_keycode_to_winit(257), Some(KeyCode::Enter));
+        assert_eq!(glfw_keycode_to_winit(258), Some(KeyCode::Tab));
+        assert_eq!(glfw_keycode_to_winit(259), Some(KeyCode::Backspace));
+        assert_eq!(glfw_keycode_to_winit(290), Some(KeyCode::F1));
+        assert_eq!(glfw_keycode_to_winit(292), Some(KeyCode::F3));
+        assert_eq!(glfw_keycode_to_winit(301), Some(KeyCode::F12));
+        assert_eq!(glfw_keycode_to_winit(340), Some(KeyCode::ShiftLeft));
+        assert_eq!(glfw_keycode_to_winit(341), Some(KeyCode::ControlLeft));
+        assert_eq!(glfw_keycode_to_winit(342), Some(KeyCode::AltLeft));
+        assert_eq!(glfw_keycode_to_winit(-1), None);
+
+        assert_eq!(glfw_keycode_to_named(256), Some(NamedKey::Escape));
+        assert_eq!(glfw_keycode_to_named(32), Some(NamedKey::Space));
+        assert_eq!(glfw_keycode_to_named(87), None);
+
+        assert_eq!(glfw_button_to_winit(0), Some(MouseButton::Left));
+        assert_eq!(glfw_button_to_winit(1), Some(MouseButton::Right));
+        assert_eq!(glfw_button_to_winit(2), Some(MouseButton::Middle));
+        assert_eq!(glfw_button_to_winit(3), Some(MouseButton::Back));
+        assert_eq!(glfw_button_to_winit(4), Some(MouseButton::Forward));
+        assert_eq!(glfw_button_to_winit(9), None);
+
+        let mods = glfw_mods_to_winit(0x01 | 0x02 | 0x04);
+        assert!(mods.contains(ModifiersState::SHIFT));
+        assert!(mods.contains(ModifiersState::CONTROL));
+        assert!(mods.contains(ModifiersState::ALT));
+        assert!(!mods.contains(ModifiersState::SUPER));
+    }
+
+    #[test]
+    fn coalesces_mouse_deltas_and_cursor_positions_without_heap_allocations() {
+        let mut queue = BlazeInputQueue::new();
+        for i in 0..100 {
+            queue.push_delta(1.5, -0.5);
+            if i == 0 || i == 99 {
+                queue.push(BlazeInputEvent::CursorPos {
+                    norm_x: 0.25 + (i as f32) * 0.001,
+                    norm_y: 0.5,
+                });
+            }
+        }
+        let (dx, dy) = queue.drain_delta();
+        assert!((dx - 150.0).abs() < 1e-6);
+        assert!((dy - (-50.0)).abs() < 1e-6);
+        assert_eq!(queue.counters.mouse_delta_events, 100);
+        assert_eq!(queue.counters.mouse_delta_coalesced, 99);
+
+        let mut buf = [BlazeInputEvent::Noop; 16];
+        let n = queue.drain_chunk(&mut buf);
+        assert_eq!(n, 1);
+        assert_eq!(
+            buf[0],
+            BlazeInputEvent::CursorPos {
+                norm_x: 0.349,
+                norm_y: 0.5,
+            }
+        );
+    }
+
+    #[test]
+    fn ring_overflow_drops_oldest_and_counts_accurately() {
+        let mut queue = BlazeInputQueue::new();
+        for k in 0..(BLAZE_INPUT_QUEUE_CAP + 10) {
+            queue.push(BlazeInputEvent::Key {
+                glfw_key: k as i32,
+                unicode_char: 0,
+                mods: 0,
+                pressed: true,
+            });
+        }
+        assert_eq!(queue.counters.dropped_overflow, 10);
+        let mut buf = [BlazeInputEvent::Noop; 64];
+        let n = queue.drain_chunk(&mut buf);
+        assert_eq!(n, 64);
+        assert_eq!(
+            buf[0],
+            BlazeInputEvent::Key {
+                glfw_key: 10,
+                unicode_char: 0,
+                mods: 0,
+                pressed: true,
+            }
+        );
+    }
+}
