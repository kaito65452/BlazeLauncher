diff --git a/crates/horizon-client/src/android/embedded_launcher.rs b/crates/horizon-client/src/android/embedded_launcher.rs
new file mode 100644
index 0000000000..7f4cd45346
--- /dev/null
+++ b/crates/horizon-client/src/android/embedded_launcher.rs
@@ -0,0 +1,314 @@
+//! Minimal embedded lifecycle driver for Blaze Launcher (`blaze-embedded` feature).
+//! Never constructs or opens Horizon's standalone launcher window; exits cleanly back to
+//! Blaze Launcher on Quit, title-screen Back, missing session/resources, or fatal error.
+use horizon_client::{
+    Result,
+    android_runtime::{
+        BlazeEngineSettings, EmbeddedExitReason, EmbeddedLaunchDecision, clear_exit_reason,
+        decide_embedded_launch, take_exit_reason, take_launcher_return,
+    },
+};
+use std::path::PathBuf;
+use winit::{
+    application::ApplicationHandler,
+    event::{DeviceEvent, DeviceId, WindowEvent},
+    event_loop::{ActiveEventLoop, ControlFlow},
+    window::WindowId,
+};
+
+pub(super) struct Launcher {
+    home: PathBuf,
+    game: Option<Box<dyn ApplicationHandler>>,
+    config: crate::catalog::Config,
+    embedded_settings: BlazeEngineSettings,
+    exit_notified: bool,
+}
+
+impl Launcher {
+    pub(super) fn new(home: PathBuf) -> Self {
+        clear_exit_reason();
+        let cleanup_home = home.clone();
+        std::thread::spawn(move || {
+            if let Err(error) =
+                horizon_client::official_install::cleanup_completed_downloads(&cleanup_home)
+            {
+                log::warn!("Could not clean completed Minecraft downloads: {error}");
+            }
+            if horizon_client::official_install::ready(&cleanup_home) {
+                let _ = horizon_client::android_resources::repair_structure_transforms(
+                    &cleanup_home.join("engine-data.zip"),
+                    &cleanup_home
+                        .join(".local/horizon-client")
+                        .join(horizon_core::VANILLA_VERSION),
+                );
+            }
+        });
+        horizon_client::android_runtime::graphics_startup::configure(home.clone());
+        let mut config = crate::catalog::Config::load(&home);
+        if horizon_client::android_runtime::graphics_startup::recover(&home) {
+            config.renderer = crate::catalog::RendererMode::VulkanCompatibility;
+            if let Err(error) = config.save(&home) {
+                log::warn!("Could not save graphics recovery choice: {error}");
+            }
+        }
+        let (embedded_settings, _) = BlazeEngineSettings::load_from_home(&home);
+        config.render_scale =
+            crate::display::RenderScale::new(embedded_settings.render_scale_percent);
+        config.input_host = if embedded_settings.show_controls {
+            crate::catalog::InputHost::Touch
+        } else {
+            crate::catalog::InputHost::KeyboardMouse
+        };
+        crate::configure_input_mode(config.input_host);
+        crate::device_runtime::configure(config.device);
+        horizon_client::ui_theme::set_ui_scale_percent(config.ui_scale_percent);
+        horizon_client::ui_theme::motion::set_launcher_animations_disabled(
+            config.disable_launcher_animations,
+        );
+        horizon_client::ui_theme::motion::set_game_animations_disabled(
+            config.disable_game_animations,
+        );
+        Self {
+            home,
+            game: None,
+            config,
+            embedded_settings,
+            exit_notified: false,
+        }
+    }
+
+    pub(super) fn configure_screen(&self) {
+        crate::native_ime::configure_screen(
+            self.config.screen.immersive,
+            self.config.screen.avoid_cutout,
+        );
+        winit::platform::android::set_native_content_aspect(self.config.screen.aspect.ratio());
+    }
+
+    fn launch_prepared_game(&mut self, events: &ActiveEventLoop) -> Result<()> {
+        let (embedded_settings, from_file) = BlazeEngineSettings::load_from_home(&self.home);
+        self.embedded_settings = embedded_settings;
+        self.config.render_scale =
+            crate::display::RenderScale::new(self.embedded_settings.render_scale_percent);
+        self.config.input_host = if self.embedded_settings.show_controls {
+            crate::catalog::InputHost::Touch
+        } else {
+            crate::catalog::InputHost::KeyboardMouse
+        };
+        log::info!(
+            "BlazeSettings: launch source={} from_file={} render_scale={} touch_look_sensitivity={:.2} show_controls={}",
+            self.embedded_settings.source,
+            from_file,
+            self.config.render_scale.percent(),
+            self.embedded_settings.touch_look_sensitivity,
+            self.embedded_settings.show_controls
+        );
+
+        crate::platform::set_orientation(self.config.orientation);
+        self.configure_screen();
+        horizon_client::ui_theme::set_android_dpi(crate::platform::display_density());
+        horizon_client::ui_theme::set_ui_scale_percent(self.config.ui_scale_percent);
+        crate::display::set_scale(self.config.render_scale);
+        horizon_client::android_runtime::configure_worker_limit(self.config.worker_limit);
+        horizon_client::android_runtime::configure_cache_budget(self.config.cache_budget_mib);
+        crate::configure_input_mode(self.config.input_host);
+        crate::device_runtime::configure(self.config.device);
+
+        horizon_client::android_resources::repair_structure_transforms(
+            &self.home.join("engine-data.zip"),
+            &self
+                .home
+                .join(".local/horizon-client")
+                .join(horizon_core::VANILLA_VERSION),
+        )?;
+        crate::platform::hide();
+        self.config.apply_experimental_to_game(&self.home);
+
+        let game_home = self.config.game_home(&self.home);
+        std::fs::create_dir_all(&game_home)?;
+        let extra_arguments = if crate::PUBLIC_BUILD {
+            Vec::new()
+        } else {
+            match std::fs::read(self.home.join("android-launch.json")) {
+                Ok(bytes) => serde_json::from_slice::<Vec<String>>(&bytes)?,
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => Vec::new(),
+                Err(e) => return Err(e.into()),
+            }
+        };
+
+        let _ = std::fs::remove_file(self.home.join("android-error.txt"));
+        if self.config.record_performance || self.config.device.gpu_profile {
+            crate::performance::start(
+                &self.home,
+                serde_json::json!({
+                    "renderer": self.config.renderer.label(),
+                    "resolution_percent": self.config.render_scale.percent(),
+                    "source_commit": option_env!("HORIZON_ANDROID_BUILD_COMMIT"),
+                    "source_dirty": option_env!("HORIZON_ANDROID_BUILD_DIRTY"),
+                    "performance_recording": self.config.record_performance,
+                    "gpu_profiling": self.config.device.gpu_profile,
+                }),
+            )?;
+        }
+
+        horizon_client::android_runtime::clear_gamepads();
+        let request = crate::game_launch::LaunchRequest {
+            resources: self
+                .home
+                .join(".local/horizon-client")
+                .join(horizon_core::VANILLA_VERSION),
+            game_home,
+            session_file: None,
+            offline_name: crate::catalog::truncate_player_name(&self.config.name),
+            server: self.config.server.clone(),
+            control_socket: (!crate::PUBLIC_BUILD).then(|| self.home.join("control.json")),
+            extra_arguments,
+            open_gl: self.config.renderer == crate::catalog::RendererMode::OpenGl,
+            gpu_batching: self.config.renderer == crate::catalog::RendererMode::Vulkan,
+        };
+        crate::document_store::set_game_active(true);
+        let game = match crate::game_launch::start(request) {
+            Ok(game) => game,
+            Err(error) => {
+                crate::document_store::set_game_active(false);
+                crate::performance::stop();
+                return Err(error);
+            }
+        };
+        horizon_client::ui_theme::reset_atlas();
+        self.game = Some(game);
+        self.game.as_mut().unwrap().resumed(events);
+        Ok(())
+    }
+
+    fn notify_and_exit(
+        &mut self,
+        events: &ActiveEventLoop,
+        reason: EmbeddedExitReason,
+        message: &str,
+    ) {
+        if !self.exit_notified {
+            self.exit_notified = true;
+            crate::game::android_reset_bundled_mods();
+            crate::document_store::set_game_active(false);
+            crate::performance::stop();
+            let _ = crate::platform::capture_mouse(false);
+            crate::platform::hide();
+            horizon_client::auth::clear_current();
+            horizon_client::auth::clear_pending_android();
+            horizon_client::android_runtime::clear_gamepads();
+            horizon_client::discord_presence::stop();
+            horizon_client::ui_theme::reset_atlas();
+            crate::diagnostics::heartbeat("embedded_exit_to_blaze", || {
+                serde_json::json!({"reason": reason.label()})
+            });
+            crate::diagnostics::finish();
+            crate::platform::notify_engine_exit(reason.code(), message);
+        }
+        events.exit();
+    }
+
+    fn handle_engine_return(&mut self, events: &ActiveEventLoop) {
+        if !take_launcher_return() {
+            return;
+        }
+        if let Some(mut game) = self.game.take() {
+            game.exiting(events);
+            drop(game);
+        }
+        let (reason, msg) = take_exit_reason();
+        let effective_reason = if reason == EmbeddedExitReason::None {
+            EmbeddedExitReason::UserQuit
+        } else {
+            reason
+        };
+        let effective_msg = if msg.is_empty() {
+            effective_reason.label().to_string()
+        } else {
+            msg
+        };
+        log::info!(
+            "BlazeEmbeddedExit: reason={} ({}) msg={}",
+            effective_reason.label(),
+            effective_reason.code(),
+            effective_msg
+        );
+        self.notify_and_exit(events, effective_reason, &effective_msg);
+    }
+}
+
+impl ApplicationHandler for Launcher {
+    fn resumed(&mut self, events: &ActiveEventLoop) {
+        self.configure_screen();
+        if let Some(game) = &mut self.game {
+            return game.resumed(events);
+        }
+        let direct = crate::take_direct_launch();
+        let ready = horizon_client::official_install::ready(&self.home);
+        let has_session = horizon_client::auth::has_pending_android();
+        match decide_embedded_launch(direct, ready, has_session) {
+            EmbeddedLaunchDecision::LaunchGame => {
+                if let Err(error) = self.launch_prepared_game(events) {
+                    let msg = error.to_string();
+                    log::error!("BlazeDirectLaunch failed: {msg}");
+                    crate::diagnostics::record_error(&msg);
+                    let _ = std::fs::write(self.home.join("android-error.txt"), &msg);
+                    self.notify_and_exit(events, EmbeddedExitReason::FatalError, &msg);
+                } else {
+                    log::info!("BlazeDirectLaunch: entered 26.3 game directly (blaze-embedded)");
+                }
+            }
+            EmbeddedLaunchDecision::ExitToLauncher(reason, message) => {
+                log::warn!("BlazeEmbeddedExit: {reason:?} - {message}");
+                self.notify_and_exit(events, reason, message);
+            }
+        }
+    }
+
+    fn suspended(&mut self, events: &ActiveEventLoop) {
+        crate::diagnostics::heartbeat("suspended", || serde_json::json!({}));
+        if let Some(game) = &mut self.game {
+            game.suspended(events);
+        }
+    }
+
+    fn window_event(&mut self, events: &ActiveEventLoop, id: WindowId, event: WindowEvent) {
+        if crate::documents::handle_event(&event) {
+            return;
+        }
+        if matches!(event, WindowEvent::Resized(_)) {
+            let _ = crate::native_ime::viewport_bottom();
+        }
+        if matches!(event, WindowEvent::Focused(true)) {
+            self.configure_screen();
+        }
+        if let Some(game) = &mut self.game {
+            game.window_event(events, id, event);
+            self.handle_engine_return(events);
+        }
+    }
+
+    fn device_event(&mut self, events: &ActiveEventLoop, id: DeviceId, event: DeviceEvent) {
+        if let Some(game) = &mut self.game {
+            game.device_event(events, id, event);
+        }
+    }
+
+    fn about_to_wait(&mut self, events: &ActiveEventLoop) {
+        if let Some(game) = &mut self.game {
+            game.about_to_wait(events);
+            self.handle_engine_return(events);
+        } else if self.exit_notified {
+            events.exit();
+        } else {
+            events.set_control_flow(ControlFlow::Wait);
+        }
+    }
+
+    fn exiting(&mut self, events: &ActiveEventLoop) {
+        if let Some(mut game) = self.game.take() {
+            game.exiting(events);
+            drop(game);
+        }
+    }
+}
