+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+#[repr(i32)]
+pub enum EmbeddedExitReason {
+    #[default]
+    None = 0,
+    UserQuit = 1,
+    TitleBack = 2,
+    NoPendingSession = 3,
+    MissingResources = 4,
+    FatalError = 5,
+    SignalOrClose = 6,
+}
+
+impl EmbeddedExitReason {
+    pub fn code(self) -> i32 {
+        self as i32
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::None => "none",
+            Self::UserQuit => "user_quit",
+            Self::TitleBack => "title_back",
+            Self::NoPendingSession => "no_pending_session",
+            Self::MissingResources => "missing_resources",
+            Self::FatalError => "fatal_error",
+            Self::SignalOrClose => "signal_or_close",
+        }
+    }
+}
+
+static EXIT_REASON: std::sync::Mutex<(EmbeddedExitReason, String)> =
+    std::sync::Mutex::new((EmbeddedExitReason::None, String::new()));
+
+pub fn set_exit_reason(reason: EmbeddedExitReason, message: impl Into<String>) {
+    let mut slot = EXIT_REASON.lock().unwrap_or_else(|e| e.into_inner());
+    if slot.0 == EmbeddedExitReason::None || reason == EmbeddedExitReason::FatalError {
+        *slot = (reason, message.into());
+    }
+}
+
+pub fn set_exit_reason_if_unset(reason: EmbeddedExitReason, message: impl Into<String>) {
+    let mut slot = EXIT_REASON.lock().unwrap_or_else(|e| e.into_inner());
+    if slot.0 == EmbeddedExitReason::None {
+        *slot = (reason, message.into());
+    }
+}
+
+pub fn take_exit_reason() -> (EmbeddedExitReason, String) {
+    let mut slot = EXIT_REASON.lock().unwrap_or_else(|e| e.into_inner());
+    std::mem::take(&mut *slot)
+}
+
+pub fn clear_exit_reason() {
+    let mut slot = EXIT_REASON.lock().unwrap_or_else(|e| e.into_inner());
+    *slot = (EmbeddedExitReason::None, String::new());
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum EmbeddedLaunchDecision {
+    LaunchGame,
+    ExitToLauncher(EmbeddedExitReason, &'static str),
+}
+
+pub fn decide_embedded_launch(
+    direct_launch: bool,
+    resources_ready: bool,
+    has_pending_session: bool,
+) -> EmbeddedLaunchDecision {
+    if !direct_launch || !has_pending_session {
+        return EmbeddedLaunchDecision::ExitToLauncher(
+            EmbeddedExitReason::NoPendingSession,
+            "No pending Blaze session; returning to Blaze Launcher.",
+        );
+    }
+    if !resources_ready {
+        return EmbeddedLaunchDecision::ExitToLauncher(
+            EmbeddedExitReason::MissingResources,
+            "Engine resources for Minecraft 26.3 are not prepared.",
+        );
+    }
+    EmbeddedLaunchDecision::LaunchGame
+}
+
+#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+#[serde(default)]
+pub struct BlazeEngineSettings {
+    pub schema: u32,
+    pub render_scale_percent: u32,
+    pub touch_look_sensitivity: f32,
+    pub show_controls: bool,
+    pub source: String,
+}
+
+impl Default for BlazeEngineSettings {
+    fn default() -> Self {
+        Self {
+            schema: 1,
+            render_scale_percent: 100,
+            touch_look_sensitivity: 1.0,
+            show_controls: true,
+            source: "default".into(),
+        }
+    }
+}
+
+impl BlazeEngineSettings {
+    pub const FILE_NAME: &'static str = "blaze_engine_settings.json";
+
+    pub fn sanitized(mut self) -> Self {
+        self.render_scale_percent = self.render_scale_percent.clamp(25, 100);
+        self.touch_look_sensitivity = if self.touch_look_sensitivity.is_finite() {
+            self.touch_look_sensitivity.clamp(0.25, 3.0)
+        } else {
+            1.0
+        };
+        if self.source.trim().is_empty() {
+            self.source = "blaze_launcher".into();
+        }
+        self
+    }
+
+    pub fn from_json_str(raw: &str) -> Result<Self, String> {
+        let parsed: Self = serde_json::from_str(raw).map_err(|e| e.to_string())?;
+        Ok(parsed.sanitized())
+    }
+
+    pub fn load_from_home(home: &std::path::Path) -> (Self, bool) {
+        let path = home.join(Self::FILE_NAME);
+        match std::fs::read_to_string(&path) {
+            Ok(raw) => match Self::from_json_str(&raw) {
+                Ok(cfg) => (cfg, true),
+                Err(err) => {
+                    log::warn!("BlazeSettings: invalid {}: {err}", path.display());
+                    (Self::default(), false)
+                }
+            },
+            Err(_) => (Self::default(), false),
+        }
+    }
+}
+
+#[cfg(test)]
+mod embedded_state_tests {
+    use super::*;
+
+    #[test]
+    fn embedded_launch_requires_direct_launch_pending_session_and_resources() {
+        assert_eq!(
+            decide_embedded_launch(false, true, true),
+            EmbeddedLaunchDecision::ExitToLauncher(
+                EmbeddedExitReason::NoPendingSession,
+                "No pending Blaze session; returning to Blaze Launcher.",
+            )
+        );
+        assert_eq!(
+            decide_embedded_launch(true, true, false),
+            EmbeddedLaunchDecision::ExitToLauncher(
+                EmbeddedExitReason::NoPendingSession,
+                "No pending Blaze session; returning to Blaze Launcher.",
+            )
+        );
+        assert_eq!(
+            decide_embedded_launch(true, false, true),
+            EmbeddedLaunchDecision::ExitToLauncher(
+                EmbeddedExitReason::MissingResources,
+                "Engine resources for Minecraft 26.3 are not prepared.",
+            )
+        );
+        assert_eq!(
+            decide_embedded_launch(true, true, true),
+            EmbeddedLaunchDecision::LaunchGame
+        );
+    }
+
+    #[test]
+    fn exit_reason_preserves_first_non_fatal_and_allows_fatal_override() {
+        clear_exit_reason();
+        set_exit_reason(EmbeddedExitReason::TitleBack, "Back on title");
+        set_exit_reason_if_unset(EmbeddedExitReason::SignalOrClose, "Ignored second");
+        assert_eq!(
+            take_exit_reason(),
+            (EmbeddedExitReason::TitleBack, "Back on title".to_string())
+        );
+        assert_eq!(take_exit_reason(), (EmbeddedExitReason::None, String::new()));
+
+        set_exit_reason(EmbeddedExitReason::UserQuit, "Quit");
+        set_exit_reason(EmbeddedExitReason::FatalError, "Vulkan lost");
+        assert_eq!(
+            take_exit_reason(),
+            (EmbeddedExitReason::FatalError, "Vulkan lost".to_string())
+        );
+    }
+
+    #[test]
+    fn blaze_engine_settings_clamps_bounds_and_handles_missing_fields() {
+        let cfg = BlazeEngineSettings::from_json_str(
+            r#"{"schema":1,"render_scale_percent":10,"touch_look_sensitivity":9.0,"show_controls":false,"source":"blaze_launcher"}"#,
+        )
+        .unwrap();
+        assert_eq!(cfg.render_scale_percent, 25);
+        assert_eq!(cfg.touch_look_sensitivity, 3.0);
+        assert!(!cfg.show_controls);
+        assert_eq!(cfg.source, "blaze_launcher");
+
+        let nan_cfg = BlazeEngineSettings {
+            touch_look_sensitivity: f32::NAN,
+            ..Default::default()
+        }
+        .sanitized();
+        assert_eq!(nan_cfg.touch_look_sensitivity, 1.0);
+    }
+}
