+/// Notify the Kotlin Activity (`RustActivity.onEngineExit(int, String)`) before shutting down `:rust`.
+pub fn notify_engine_exit(reason_code: i32, message: &str) {
+    with_context(|env, activity| {
+        let msg = JObject::from(env.new_string(message)?);
+        let _ = env.call_method(
+            activity,
+            "onEngineExit",
+            "(ILjava/lang/String;)V",
+            &[JValue::Int(reason_code), JValue::Object(&msg)],
+        );
+        if env.exception_check().unwrap_or(false) {
+            let _ = env.exception_clear();
+        }
+        Ok(())
+    });
+}
