+    /// Observe the current focus state at monotonic timestamp `now_ms`.
+    /// Returns `Some((active, source))` ONLY when a change survives the debounce window,
+    /// coalescing fast flickers (e.g., 97 ms `false -> true -> false`) and suppressing duplicates.
+    pub fn observe_at(
+        &mut self,
+        active: bool,
+        raw_source: &'static str,
+        now_ms: u64,
+    ) -> Option<(bool, &'static str)> {
+        let source = if active { raw_source } else { "none" };
+        if let Some(pending) = self.pending {
+            if pending.active == active && pending.source == source {
+                if now_ms.saturating_sub(pending.since_ms) >= BLAZE_TEXT_INPUT_DEBOUNCE_MS {
+                    self.pending = None;
+                    if active != self.emitted_active || (active && source != self.emitted_source) {
+                        self.emitted_active = active;
+                        self.emitted_source = source;
+                        return Some((active, source));
+                    }
+                }
+                return None;
+            }
+            if active == self.emitted_active && (!active || source == self.emitted_source) {
+                // Transient flicker reverted back before the debounce window elapsed.
+                self.pending = None;
+                return None;
+            }
+            self.pending = Some(PendingTextInputTransition {
+                active,
+                source,
+                since_ms: now_ms,
+            });
+            return None;
+        }
+        if active == self.emitted_active && (!active || source == self.emitted_source) {
+            return None;
+        }
+        self.pending = Some(PendingTextInputTransition {
+            active,
+            source,
+            since_ms: now_ms,
+        });
+        None
+    }
+
+    pub fn reset(&mut self) {
+        self.emitted_active = false;
+        self.emitted_source = "none";
+        self.pending = None;
+    }
+}
