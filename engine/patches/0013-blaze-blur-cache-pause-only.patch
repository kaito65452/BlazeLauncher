+/// Only singleplayer pause may cache the blurred world backdrop; chat, inventory, creative,
+/// and multiplayer UI screens must keep rendering the live world every frame.
+pub const fn should_cache_menu_blur(
+    singleplayer_paused: bool,
+    shows_panorama: bool,
+    has_menu_blur: bool,
+) -> bool {
+    singleplayer_paused && !shows_panorama && has_menu_blur
+}
+
+pub fn record_ui_frame_render_state(
+    world_rendered_with_ui: bool,
+    non_pause_ui_open: bool,
+    menu_blur_cache_active: bool,
+) {
+    let mut guard = BLAZE_INPUT_QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+    if world_rendered_with_ui {
+        guard.counters.world_frames_while_ui_open += 1;
+    }
+    if non_pause_ui_open {
+        guard.counters.ui_overlay_cache_active = menu_blur_cache_active;
+    }
+}
+
 static BLAZE_SURFACE_RECT: [std::sync::atomic::AtomicI32; 6] = [
     std::sync::atomic::AtomicI32::new(0),
     std::sync::atomic::AtomicI32::new(0),
@@ -1106,4 +1134,25 @@ mod input_bridge_tests {
         assert_eq!(input_counters().text_input_active_signals, 2);
         reset_input_metrics_for_test();
     }
+
+    #[test]
+    fn blur_cache_disabled_for_inventory_creative_chat_and_multiplayer() {
+        // Screen::Inventory, Screen::Creative, Screen::Chat: singleplayer_paused == false
+        assert!(!should_cache_menu_blur(false, false, true));
+        // Multiplayer (any screen, including Options or Esc menu): singleplayer_paused == false
+        assert!(!should_cache_menu_blur(false, false, false));
+        // Title/panorama: shows_panorama == true
+        assert!(!should_cache_menu_blur(true, true, true));
+        // Menu blur off: has_menu_blur == false
+        assert!(!should_cache_menu_blur(true, false, false));
+        // Singleplayer pause with menu blur enabled: allowed
+        assert!(should_cache_menu_blur(true, false, true));
+
+        reset_input_metrics_for_test();
+        record_ui_frame_render_state(true, true, should_cache_menu_blur(false, false, true));
+        let counters = input_counters();
+        assert_eq!(counters.world_frames_while_ui_open, 1);
+        assert!(!counters.ui_overlay_cache_active);
+        reset_input_metrics_for_test();
+    }
 }
