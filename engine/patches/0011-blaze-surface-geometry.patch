+static BLAZE_SURFACE_RECT: [std::sync::atomic::AtomicI32; 6] = [
+    std::sync::atomic::AtomicI32::new(0),
+    std::sync::atomic::AtomicI32::new(0),
+    std::sync::atomic::AtomicI32::new(0),
+    std::sync::atomic::AtomicI32::new(0),
+    std::sync::atomic::AtomicI32::new(0),
+    std::sync::atomic::AtomicI32::new(0),
+];
+
+pub fn update_blaze_surface_rect(
+    surf_x: i32,
+    surf_y: i32,
+    surf_w: i32,
+    surf_h: i32,
+    buf_w: i32,
+    buf_h: i32,
+) {
+    let vals = [surf_x, surf_y, surf_w, surf_h, buf_w, buf_h];
+    for (slot, val) in BLAZE_SURFACE_RECT.iter().zip(vals) {
+        slot.store(val, Ordering::Release);
+    }
+}
+
+pub fn blaze_surface_rect() -> [i32; 6] {
+    let mut out = [0; 6];
+    for (dst, slot) in out.iter_mut().zip(BLAZE_SURFACE_RECT.iter()) {
+        *dst = slot.load(Ordering::Acquire);
+    }
+    out
+}
