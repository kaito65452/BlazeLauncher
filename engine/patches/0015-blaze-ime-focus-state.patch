@@ -546,6 +546,24 @@ pub struct BlazeInputCounters {
     pub ui_overlay_cache_active: bool,
 }
 
+static BLAZE_TEXT_INPUT_ACTIVE: AtomicBool = AtomicBool::new(false);
+
+pub fn blaze_text_input_active() -> bool {
+    BLAZE_TEXT_INPUT_ACTIVE.load(Ordering::Acquire)
+}
+
+/// Updates the engine text-input-active state and returns `true` only on an actual
+/// `false -> true` or `true -> false` transition (initial state is `false`).
+pub fn update_text_input_active_state(active: bool) -> bool {
+    let prev = BLAZE_TEXT_INPUT_ACTIVE.swap(active, Ordering::AcqRel);
+    if prev != active {
+        record_text_input_active_signal();
+        true
+    } else {
+        false
+    }
+}
+
 struct BlazeInputQueue {
