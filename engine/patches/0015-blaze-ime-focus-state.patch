-        record_text_input_active_signal();
-        record_text_input_active_signal();
+        // Repeated false at startup (initial state is false) must not emit a signal.
+        assert!(!update_text_input_active_state(false));
+        assert_eq!(input_counters().text_input_active_signals, 0);
+        // false -> true emits once; duplicate true is suppressed.
+        assert!(update_text_input_active_state(true));
+        assert!(blaze_text_input_active());
+        assert!(!update_text_input_active_state(true));
+        assert_eq!(input_counters().text_input_active_signals, 1);
+        // true -> false emits once; duplicate false is suppressed.
+        assert!(update_text_input_active_state(false));
+        assert!(!blaze_text_input_active());
+        assert!(!update_text_input_active_state(false));
         assert_eq!(input_counters().text_input_active_signals, 2);
         reset_input_metrics_for_test();
     }
